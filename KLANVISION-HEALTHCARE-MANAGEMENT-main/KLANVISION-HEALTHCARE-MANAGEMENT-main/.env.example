# Copy this file to server/.env and add your MongoDB Atlas connection details.
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smart-healthcare?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional; place this in client/.env.local to override the API address.
# VITE_API_URL=http://localhost:5000/api
