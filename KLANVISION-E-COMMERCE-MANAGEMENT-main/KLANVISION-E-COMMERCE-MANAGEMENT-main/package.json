{
  "name": "e-commerce-order-inventory",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "seed:products": "npm run seed:products --prefix server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
